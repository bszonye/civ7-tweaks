<?xml version="1.0" encoding="utf-8"?>
<Mod id="bz-tweaks" version="10000" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_BZ_TWEAKS_NAME</Name>
        <Version>1.0.0</Version>
        <Description>LOC_MOD_BZ_TWEAKS_DESCRIPTION</Description>
        <Authors>beezany</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <References>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
        <Criteria id="bz-age-antiquity">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="bz-age-exploration">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="bz-age-modern">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="bz-tweak-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <ImportFiles>
                    <Item>ui/shell/mods-content/mods-content.js</Item>
                </ImportFiles>
                <UIScripts>
                    <Item>ui/shell/bz-tweak-shell.js</Item>
                </UIScripts>
                <UpdateDatabase>
                    <Item>data/bz-tweak-shell.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-tweak-always" scope="game" criteria="always">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <ImportFiles>
                    <Item>ui/diplo-ribbon/panel-diplo-ribbon.js</Item>
                </ImportFiles>
                <UIScripts>
                    <Item>ui/diplo-ribbon/bz-panel-diplo-ribbon.js</Item>
                </UIScripts>
                <UpdateDatabase>
                    <Item>data/bz-tweak-age-progress.sql</Item>
                    <Item>data/bz-tweak-always.sql</Item>
                    <Item>data/bz-tweak-always.xml</Item>
                </UpdateDatabase>
                <UpdateIcons>
                    <Item>data/bz-tweak-always-icons.xml</Item>
                </UpdateIcons>
                <UpdateText>
                    <Item>text/en_us/InGameText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-tweak-antiquity" scope="game" criteria="bz-age-antiquity">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-tweak-antiquity.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-tweak-exploration" scope="game" criteria="bz-age-exploration">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-tweak-exploration.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-tweak-modern" scope="game" criteria="bz-age-modern">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-tweak-modern.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
